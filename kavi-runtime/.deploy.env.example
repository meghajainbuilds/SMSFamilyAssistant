# Copy to .deploy.env (gitignored) and fill in your own values.
# Read by scripts/load_deploy_env.sh; environment variables override.
# ssh target for the always-on Mac that runs Kavi
KAVI_HOST=kavi@100.64.0.10
# that Mac's address on your private mesh (e.g. Tailscale IP)
KAVI_ADDR=100.64.0.10
# a household iMessage handle verify_deploy.sh uses as the smoke sender
KAVI_SMOKE_HANDLE=+15555550101
