# Real .env lives at ~/.config/kavi/.env on Kavi's Mac (chmod 600).
# Never commit a populated .env to any repo.

ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXX

# BlueBubbles password (read by bluebubbles_client at startup; matches BlueBubbles UI password)
BLUEBUBBLES_PASSWORD=replace-me

# MS Graph OAuth (set after first interactive auth flow; refresh token persists)
MS_GRAPH_CLIENT_ID=replace-me
MS_GRAPH_TENANT_ID=consumers
MS_GRAPH_REFRESH_TOKEN=set-after-first-auth

# Cloudflare Tunnel persistent URL (also in config.yaml; env var wins for overrides)
KAVI_PUBLIC_URL=https://kavi.example.com
