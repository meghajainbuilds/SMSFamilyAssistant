<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.megha.kavi</string>

    <key>ProgramArguments</key>
    <array>
      <string>/Users/kavi/kavi-runtime/.venv/bin/kavi-runtime</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>/Users/kavi/.local/bin:/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/kavi/kavi-runtime</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
      <key>SuccessfulExit</key>
      <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/kavi/Library/Logs/kavi-runtime.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/kavi/Library/Logs/kavi-runtime.err.log</string>

    <key>ThrottleInterval</key>
    <integer>30</integer>
  </dict>
</plist>
