# Local secrets — never commit
.env
.env.local
*_token*.json
graph_token_cache.json
graph_subscription.json

# But: regression library fixtures are not secrets even when their
# filenames happen to contain "token" (e.g. "max_tokens_400_clips" /
# "apostrophe_tokenizer_zero_matches"). Re-include explicitly so the
# permanence guarantee on production-trace fixtures holds.
!kavi-runtime/tests/regression/fixtures/*.json

